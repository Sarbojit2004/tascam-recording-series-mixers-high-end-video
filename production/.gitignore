# Dependencies and build caches
node_modules/
.remotion/

# Prepared asset mirrors. Regenerate with:
#   python3 scripts/prepare_assets.py && python3 scripts/make_logos.py && python3 scripts/knockout.py
# They are derived entirely from the real photography, the four product videos
# and the 17 Gemini clips already tracked at the repository root.
assets/img/
assets/logo/
assets/video/
assets/clips/
assets/fonts/

# Intermediate audio. The DELIVERED audio is committed as FLAC in each
# project's out/ directory; these WAVs are what the compositions mount and are
# regenerated by scripts/build_music.py, scripts/synth-sfx.mjs and
# scripts/make-sfx-timeline.mjs — or restored losslessly from the committed
# FLACs by scripts/audio-expand.sh.
assets/audio/
*/public/audio/

# Synced copies of shared/ and the prepared assets. `node scripts/sync.mjs
# <longform|reels>` recreates them.
*/src/shared/
*/public/img/
*/public/logo/
*/public/video/
*/public/clips/
*/public/fonts/

# QA output — stills are a checkpoint artefact, not a deliverable.
*/out/qa/
*/out/probe/
*/out/fix/
*/out/bench.mp4
*/out/*.log

# GitHub hard-rejects files over 100 MB and git-lfs is not available here, so
# the 898 s render ships as keyframe-aligned chunks in out/parts/ plus
# scripts/join.sh, which reconstructs it exactly (verified bit-identical).
longform/out/tascam-model-series-longform.mp4
